# VLA-RL Framework .gitignore

# ============ Python ============
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ============ 环境 ============
# Virtual environments (注意：不影响 env/ 目录下的源代码)
venv/
.env/
ENV/
.venv/
rl_env/
*.virtualenv

# Conda
.conda/
*.conda

# ============ IDE / 编辑器 ============
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============ 训练产物 ============
# Checkpoints (保留 checkpoints/ 目录结构，但忽略具体模型文件)
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.ckpt
checkpoints/**/*.safetensors

# Logs
logs/
*.log
*.out

# TensorBoard
runs/
events.out.tfevents.*

# Wandb
wandb/

# ============ 数据文件 ============
# HDF5 数据（通常很大，不提交到 Git）
*.hdf5
*.h5
data/**/*.hdf5
data/**/*.h5

# 其他数据格式
*.pkl
*.pickle
*.npy
*.npz

# 视频/图像（如果生成了轨迹视频）
*.mp4
*.avi
*.gif
videos/

# ============ 系统文件 ============
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ============ 临时文件 ============
*.tmp
*.temp
*.bak
*.cache

# ============ 其他 ============
# 环境变量
.env
.env.local

# 压缩文件
*.zip
*.tar.gz
*.rar

# 保留的重要文件（确保不被忽略）
!requirements.txt
!README.md
!LICENSE
!.github/copilot-instructions.md

# 保留 checkpoints 目录结构（但忽略模型文件）
!checkpoints/.gitkeep
!checkpoints/*/.gitkeep
